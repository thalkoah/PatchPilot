# Development-only example credentials for local Compose.
# Copy to .env to override. Do not reuse this password anywhere else.
POSTGRES_USER=patchpilot
POSTGRES_PASSWORD=patchpilot_dev
POSTGRES_DB=patchpilot

# Hostname `db` is the Compose service. Use localhost only when the API runs on the host.
# Alembic reads this same URL. Compose runs `alembic upgrade head` before the API serves traffic.
# LangGraph checkpoint tables use this URL too. Create them with
# `uv run python -m patchpilot.checkpoints`. Alembic does not migrate them.
DATABASE_URL=postgresql://patchpilot:patchpilot_dev@db:5432/patchpilot
DB_CONNECT_TIMEOUT_SECONDS=3
# Seconds the worker waits between polls when nothing is queued.
WORKER_IDLE_SLEEP_SECONDS=2
# How long a worker owns a running task. A live worker renews the lease.
# An expired lease is recovered until WORKER_MAX_ATTEMPTS, then the task is failed.
WORKER_LEASE_SECONDS=30
WORKER_MAX_ATTEMPTS=3
# Read-only repository tool calls one investigation may make. 1–12.
INVESTIGATOR_MAX_TOOL_CALLS=6
# When true, the supervisor asks the configured model for a route. Deterministic
# rules remain authoritative and reject any route they did not allow.
SUPERVISOR_MODEL=false
# Plan files. Compose sets this to /artifacts on the API and the worker.
# A host process that reads plans needs the same absolute directory the worker wrote.
# ARTIFACTS_ROOT=/var/lib/patchpilot/artifacts
# Private clones created after a plan is approved. Compose sets this to
# /workspaces on the worker only. The registered checkout stays read-only.
# WORKSPACE_ROOT=/var/lib/patchpilot/workspaces
# Job files for the restricted pytest runner. Compose sets this to /runner on
# the worker and the runner service. The API does not receive it. The runner
# container has no database password, no model settings, and no network.
# A shared runner volume isolates tasks less strictly than a fresh mount per
# task. Keep concurrency at 1.
# RUNNER_ROOT=/var/lib/patchpilot/runner
# The runner kills pytest after this many seconds. The worker waits longer.
RUNNER_TIMEOUT_SECONDS=30
RUNNER_WAIT_SECONDS=45
LOG_LEVEL=INFO

# Offline provider. pytest and CI keep this as fake.
# Set LLM_PROVIDER=ollama only for a manual local model. The README explains how
# a Compose worker reaches Ollama on a Fedora host, and why port 11434 stays closed.
LLM_PROVIDER=fake
LLM_MODEL=gemma4:12b
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
# Pause between retries of a timeout, invalid JSON, or a transient HTTP status.
LLM_RETRY_BACKOFF_SECONDS=0.5
# Optional per-stage overrides. Empty uses LLM_PROVIDER and LLM_MODEL everywhere.
# Example: triage=ollama:gemma4:12b,review=openai:gpt-4.1-mini
LLM_STAGE_MODELS=
# Ollama structured output is on. Native tool calling stays off until the model supports it.
OLLAMA_TOOL_CALLING=false
# Cloud calls stay off until this is true and the three settings below are set.
# The worker is the only service that receives the key. The runner and the API do not.
LLM_CLOUD_ENABLED=false
# LLM_CLOUD_BASE_URL=https://api.openai.com/v1
# LLM_CLOUD_API_KEY=
# LLM_CLOUD_CAPABILITIES=structured_output
# Cost stays unknown unless this local file verifies a price for that exact model.
# The file is JSON: {"version": 1, "prices": {"fake:gemma4:12b": {"prompt_usd_per_million": "0", "output_usd_per_million": "0", "verified": true}}}
# LLM_PRICING_PATH=/absolute/path/model-prices.json
# Per-task ceilings. Parallelism cannot be raised above one.
TASK_MAX_MODEL_CALLS=24
TASK_MAX_TOOL_CALLS=12
TASK_MAX_TOKENS=100000
TASK_MAX_RUNTIME_SECONDS=900
TASK_MAX_PARALLELISM=1
TASK_MAX_REPAIRS=2
# Host process. Leave this unset so Compose uses http://host.docker.internal:11434.
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Directory of local Git checkouts. The worker mount is read-only.
# Compose maps REPOSITORY_ROOT_HOST onto /repositories and sets
# REPOSITORY_ROOT=/repositories inside the worker.
# A host admin command uses an absolute REPOSITORY_ROOT instead.
# REPOSITORY_ROOT=/absolute/path/to/PatchPilot/examples
REPOSITORY_ROOT_HOST=./examples
