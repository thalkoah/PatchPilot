# Development-only example credentials for local Compose.
# Copy to .env to override. Do not reuse this password anywhere else.
POSTGRES_USER=patchpilot
POSTGRES_PASSWORD=patchpilot_dev
POSTGRES_DB=patchpilot

# Hostname `db` is the Compose service. Use localhost only when the API runs on the host.
# Alembic reads this same URL. Compose runs `alembic upgrade head` before the API serves traffic.
DATABASE_URL=postgresql://patchpilot:patchpilot_dev@db:5432/patchpilot
DB_CONNECT_TIMEOUT_SECONDS=3
WORKER_IDLE_SLEEP_SECONDS=30
LOG_LEVEL=INFO

# Offline provider. pytest and CI keep this as fake.
# Set LLM_PROVIDER=ollama only for a manual local model. The README explains how
# a Compose worker reaches Ollama on a Fedora host, and why port 11434 stays closed.
LLM_PROVIDER=fake
LLM_MODEL=gemma4:12b
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
# Host process. Leave this unset so Compose uses http://host.docker.internal:11434.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
